# JWT Secret — случайная строка для подписи токенов (обязательно поменяй!)
JWT_SECRET=change-me-to-random-secret-string

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_CHAT_ID=@your_channel or -1001234567890

# VKontakte — VK ID OAuth 2.1 + PKCE (id.vk.com)
VK_APP_ID=12345678
VK_APP_SECRET=защищённый_ключ_из_настроек_приложения
VK_REDIRECT_URI=https://yourdomain.com/oauth/vk/callback
VK_API_VERSION=5.199
VK_OAUTH_SCOPES=wall,photos,groups,offline

# Одноклассники (OK.ru) — credentials приложения (не пользователя, OAuth flow)
OK_APP_ID=12345678
OK_APPLICATION_KEY=ABCDEFGHIJKLMN
OK_SECRET_KEY=секретный_ключ_из_настроек_приложения

# Facebook Pages — OAuth 2.0 (пользователи авторизуются через твоё приложение)
FB_APP_ID=123456789012345
FB_APP_SECRET=abcdef1234567890abcdef1234567890

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=EAAxxxxx
INSTAGRAM_USER_ID=17841400000000000

# X (Twitter) — OAuth 2.0 PKCE (пользователи авторизуются через твоё приложение)
TWITTER_CLIENT_ID=xxxxx
TWITTER_CLIENT_SECRET=xxxxx

# Яндекс Дзен (RSS)
ZEN_FEED_TITLE=Мой Дзен Канал
ZEN_AUTHOR_NAME=Автор
